# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# --- required -----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- tracing (optional) -------------------------------------------------
# Off unless LANGSMITH_TRACING is truthy AND a key is set; missing config is a
# no-op, never an error. Worth turning on when a route is behaving oddly: both
# graph paths fail by route rather than by node, and parallel agents interleave
# their logs into something unreadable.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=defi-info

# --- overrides (optional) -----------------------------------------------
# Every field in src/config.py can be set here; the defaults there are the
# authority. Listed below are the ones worth knowing about.

# Models. All three default to the same model; routing and judging are split out
# so either can be moved to a cheaper one without touching answer quality.
# MODEL_ID=claude-opus-4-8
# ROUTER_MODEL_ID=claude-opus-4-8
# JUDGE_MODEL_ID=claude-opus-4-8

# Local state. Deleting any of these is safe — the index rebuilds from the
# corpus mirror, and the feature store refills from scheduled collection,
# though history already gathered is not backfillable.
# CHROMA_DIR=.chroma
# FEATURE_STORE=.features.sqlite

# Retrieval funnel: each retriever returns RETRIEVE_K, RRF fuses to FUSE_K, the
# cross-encoder reranks down to CONTEXT_K, which is what reaches the prompt.
# RETRIEVE_K=15
# FUSE_K=20
# CONTEXT_K=5
# RERANK_ENABLED=true

# Semantic entailment in the Verification Agent — one model call per surviving
# claim. Off by default: the right thing to pay for on an investigation someone
# will act on, the wrong thing to pay on every turn. When off, reports say the
# check did not run rather than implying it passed.
# VERIFY_ENTAILMENT=false

# Data sources. HYPEREVM_EXPLORER is a link base for citations only; chain reads
# go over JSON-RPC and their hosts live in src/blockchain/rpc.py.
# HYPERLIQUID_API=https://api.hyperliquid.xyz
# HYPEREVM_EXPLORER=https://www.hyperscan.com
